{
  "name": "lumina-image-saas",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts examples/landing-page examples/extension-client",
    "format": "biome format --write --javascript-formatter-enabled=true --css-formatter-enabled=true src tests scripts",
    "test": "vitest run",
    "check": "npm run build && npm run typecheck && npm run lint && npm test",
    "cf-typegen": "wrangler types --include-env false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node --import tsx scripts/setup.ts migrate --remote",
    "db:studio": "node --import tsx scripts/db-studio.ts --local",
    "db:admin:local": "node --import tsx scripts/admin.ts --local",
    "db:admin:remote": "node --import tsx scripts/admin.ts --remote",
    "setup": "node --import tsx scripts/setup.ts",
    "deploy": "node --import tsx scripts/setup.ts deploy",
    "i18n:check": "node --import tsx scripts/check-i18n.ts",
    "doctor": "node --import tsx scripts/setup.ts doctor",
    "sync-worker-secrets": "node --import tsx scripts/setup.ts sync-worker-secrets",
    "sync-github-secrets": "node --import tsx scripts/setup.ts sync-github-secrets",
    "test:e2e": "node --import tsx scripts/browser-tests.ts --all",
    "test:production": "node --import tsx scripts/browser-tests.ts --all",
    "check:production": "npm run build && npm run test:production",
    "db:studio:local": "node --import tsx scripts/db-studio.ts --local",
    "db:studio:remote": "node --import tsx scripts/db-studio.ts --remote",
    "auth:schema:generate": "node --import tsx scripts/auth-schema.ts",
    "test:worker": "node --import tsx scripts/browser-tests.ts --http",
    "check:worker": "npm run build && npm run test:worker",
    "locale:check": "node --import tsx scripts/check-i18n.ts",
    "locale:sort": "node --import tsx scripts/locale.ts sort",
    "locale:compile": "node --import tsx scripts/locale.ts compile",
    "email:dev": "email dev --dir src/mail/templates --port 3001",
    "test:sandbox": "playwright test --config playwright.sandbox.config.ts",
    "test:sandbox:preflight": "node --import tsx scripts/provider-sandbox.ts",
    "test:sandbox:unit": "vitest run tests/sandbox/harness.test.ts",
    "db:push": "node --import tsx scripts/db-push.ts --local",
    "db:push:local": "node --import tsx scripts/db-push.ts --local",
    "db:push:remote": "node --import tsx scripts/db-push.ts --remote",
    "pretypecheck": "npm run cf-typegen",
    "test:privacy": "node --import tsx scripts/privacy-test.ts",
    "payment:recover": "node --import tsx scripts/payment-recovery.ts",
    "smoke:local": "node --import tsx scripts/local-smoke.ts",
    "e2e:stripe": "node --import tsx scripts/run-provider-sandbox.ts stripe",
    "e2e:creem": "node --import tsx scripts/run-provider-sandbox.ts creem",
    "e2e:waffo": "node --import tsx scripts/run-provider-sandbox.ts waffo",
    "test:performance": "node --import tsx scripts/performance-test.ts",
    "check:local": "npm run check && npm run i18n:check && npm run test:worker && npm run test:performance",
    "preemail:dev": "npm run locale:compile",
    "test:browser": "node --import tsx scripts/browser-tests.ts --browser",
    "test:mail:browser": "node --import tsx scripts/browser-tests.ts --captured",
    "test:lumina": "node --import tsx scripts/browser-tests.ts --lumina",
    "demo:local": "node --import tsx scripts/lumina-demo.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/api-key": "1.7.12",
    "@better-auth/core": "1.7.12",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@tanstack/ai": "1.0.0",
    "@tanstack/ai-fal": "1.0.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@waffo/pancake-ts": "0.26.0",
    "better-auth": "1.7.12",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "gray-matter": "4.0.3",
    "lucide-react": "1.61.0",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.3",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@cloudflare/vite-plugin": "1.65.0",
    "@content-collections/core": "0.15.3",
    "@content-collections/vite": "0.3.1",
    "@inlang/paraglide-js": "2.29.1",
    "@libsql/client": "0.18.0",
    "@playwright/test": "1.64.1",
    "@react-email/ui": "6.11.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "auth": "1.7.12",
    "axe-core": "4.14.0",
    "drizzle-kit": "0.31.11",
    "miniflare": "5.20261019.2-beta",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "edgekit": {
    "template": "cloudflare-saas-starter",
    "schemaVersion": 1
  },
  "description": "Lumina: a private image studio built from SaaSStarterKit v0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agioracle/SaaSStarterKit-Example.git"
  },
  "files": [
    "src",
    "public",
    "content",
    "messages",
    "project.inlang/settings.json",
    "drizzle",
    "scripts",
    "tests",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "*.ts",
    "*.json",
    "*.jsonc",
    ".env.example",
    ".dev.vars.example",
    ".github",
    ".editorconfig",
    ".npmrc"
  ]
}
