# Build-time, public, bundled in browser. Never put secrets in VITE_*.
VITE_BASE_URL=http://localhost:3000
# VITE_APP_URL is a compatibility fallback only when VITE_BASE_URL is unset.
# Optional public analytics IDs, disabled by default.
VITE_GOOGLE_ANALYTICS_ID=
VITE_PLAUSIBLE_DOMAIN=
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT=
VITE_PLAUSIBLE_SCRIPT=
VITE_CLARITY_PROJECT_ID=
VITE_CRISP_WEBSITE_ID=

# Leave unset to disable paid checkout; the example pricing page remains visible. Choices: stripe, creem, waffo.
VITE_PAYMENT_PROVIDER=
VITE_STRIPE_PRICE_PRO_MONTHLY=
VITE_STRIPE_PRICE_PRO_YEARLY=
VITE_STRIPE_PRICE_LIFETIME=
VITE_CREEM_PRODUCT_PRO_MONTHLY=
VITE_CREEM_PRODUCT_PRO_YEARLY=
VITE_CREEM_PRODUCT_LIFETIME=
VITE_WAFFO_PRODUCT_PRO_MONTHLY=
VITE_WAFFO_PRODUCT_PRO_YEARLY=
VITE_WAFFO_PRODUCT_LIFETIME=

# Optional public links; empty values omit the link.
VITE_GITHUB_URL=
VITE_X_URL=
VITE_SUPPORT_EMAIL=
# CLI synchronization: omitted public keys remain unchanged remotely.
# Empty values require explicit --clear-public KEY when syncing to GitHub.
# VITE_PAYMENT_PROVIDER=none is an explicit nonempty disabled setting.
