/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# /assets is reserved for Vite fingerprinted build output. The performance gate
# rejects unhashed assets here and forbids a public/assets source directory.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unversioned brand assets must revalidate when updated.
/og.png
  Cache-Control: public, max-age=0, must-revalidate
