{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumina-example",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumina-example",
      "database_id": "replace-with-your-d1-id",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "lumina-example-files"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "replace-with-your-kv-id"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "APP_URL": "http://localhost:3000",
    "MAINTENANCE_ENABLED": "true"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
